# .env

## SETUP


# The bot token that can be generated from https://discordpy.readthedocs.io/en/stable/discord.html
DISCORD_TOKEN=
# Can be found in https://discord.com/developers/applications/BOT_ID/information
BOT_ID=
# Server name
DISCORD_GUILD=

## ROLES
# Note: Don't prefix roles with '@'

# Role that gives members access to privileged commands
ADMIN_ROLE=
# Role that is added to new members automatically
WELCOME_ROLE=
# Movie night role
MOVIE_ROLE=

## CHANNELS
# Note: Don't prefix channels with '#'

# Text channel that bot posts on without spamming
MAIN_CHANNEL=
# Text channel for bot to spam in
BOT_CHANNEL=
# Text channel where bot posts announcements
ANNOUNCEMENT_CHANNEL=
# Text channel where bot posts memes
MEME_CHANNEL=
# Text channel where bot posts dota-related messages
DOTA_CHANNEL=
# Text channel for movie night stuff
MOVIE_CHANNEL=

## ANNOUNCEMENTS

# 0 for monday, 1 for tuesday, etc. 6 = sunday
ANNOUNCEMENT_DAY=
# An integer from 0-23
ANNOUNCEMENT_HOUR=
# An integer from 0-59
ANNOUNCEMENT_MIN=

## TWITCH

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

## YOUTUBE

YOUTUBE_API_KEY=
